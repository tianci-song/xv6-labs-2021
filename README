======  send  ======												===== receive =====

		sock_write()																sockrecvudp()
				 |																					 |
				 |																					 |
		net_tx_udp()				   udp layer						net_rx_udp()
				 |																					 |
				 |																					 |
		net_tx_ip()						 ip layer							 net_rx_ip()
				 |																					 |
				 |																					 |
		net_tx_eth()					 data layer							net_rx()
				 |																					 |
				 |																					 |
		e1000_transmit() ------> e1000_intr() -----> e1000_recv()
